<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Acesso Proibido — Painel Acessilia Gestor</title>
  <link rel="stylesheet" href="/public/css/reset.css">
  <link rel="stylesheet" href="/public/css/variables.css">
  <link rel="stylesheet" href="/public/css/components.css">
  <link rel="stylesheet" href="/public/css/layout.css">
</head>
<body style="display: flex; align-items: center; justify-content: center; min-height: 100vh;">
  <main class="auth-card" role="main" style="text-align: center;">
    <h1 style="color: var(--color-error); font-size: 2rem; margin-bottom: 1rem;">403 — Acesso Proibido</h1>
    <p style="margin-bottom: 1.5rem; color: var(--text-secondary);">
      Seu perfil (<%= user ? user.roleName : 'Convidado' %>) não possui a permissão necessária (<code><%= requiredPermission %></code>) para acessar este recurso.
    </p>
    <a href="/dashboard" class="btn btn-primary">Voltar para o Início</a>
  </main>
</body>
</html>
