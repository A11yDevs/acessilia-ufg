<div style="margin-bottom: 2rem;">
  <h1 style="font-size: 1.75rem; font-weight: 700;">Revisões de Acessibilidade</h1>
  <p style="color: var(--text-muted);">Fila de análise técnica humana e controle de qualidade WCAG 2.2</p>
</div>

<!-- FILA DE MATERIAIS AGUARDANDO REVISÃO -->
<section aria-labelledby="sec-fila" style="margin-bottom: 2.5rem;">
  <h2 id="sec-fila" style="font-size: 1.25rem; font-weight: 600; margin-bottom: 1rem;">
    Fila de Materiais para Análise (<%= pendingMaterials.length %>)
  </h2>

  <div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--border-radius); overflow-x: auto;">
    <table style="width: 100%; border-collapse: collapse; text-align: left;" aria-describedby="sec-fila">
      <thead>
        <tr style="border-bottom: 2px solid var(--border-color); background: rgba(0,0,0,0.02);">
          <th scope="col" style="padding: 1rem;">Título do Material</th>
          <th scope="col" style="padding: 1rem;">Disciplina</th>
          <th scope="col" style="padding: 1rem;">Docente</th>
          <th scope="col" style="padding: 1rem;">Status Atual</th>
          <th scope="col" style="padding: 1rem;">Versão</th>
          <th scope="col" style="padding: 1rem;">Ações de Revisão</th>
        </tr>
      </thead>
      <tbody>
        <% if (pendingMaterials.length === 0) { %>
          <tr>
            <td colspan="6" style="padding: 2rem; text-align: center; color: var(--text-muted);">
              Nenhum material pendente de revisão no momento.
            </td>
          </tr>
        <% } else { %>
          <% pendingMaterials.forEach(m => { %>
            <tr style="border-bottom: 1px solid var(--border-color);">
              <td style="padding: 1rem; font-weight: 600;"><%= m.title %></td>
              <td style="padding: 1rem;"><%= m.subject_name %></td>
              <td style="padding: 1rem; color: var(--text-secondary);"><%= m.teacher_name %></td>
              <td style="padding: 1rem;">
                <span class="role-tag" style="background: var(--color-warning);">
                  <%= m.current_status %>
                </span>
              </td>
              <td style="padding: 1rem; font-weight: 700;">v<%= m.latest_version_number %></td>
              <td style="padding: 1rem; display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                <a href="/materiais/<%= m.id %>" class="btn" style="border: 1px solid var(--border-color); padding: 0.375rem 0.75rem; font-size: 0.875rem;">
                  Ver Arquivo
                </a>

                <% if (m.current_status === 'AGUARDANDO_REVISAO' && (user.roleCode === 'ADMINISTRADOR' || user.permissions.includes('revisoes.avaliar'))) { %>
                  <form action="/revisoes/iniciar" method="POST" style="display: inline;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="materialVersionId" value="<%= m.latest_version_id %>">
                    <button type="submit" class="btn btn-primary" style="padding: 0.375rem 0.75rem; font-size: 0.875rem;">
                      Assumir Revisão
                    </button>
                  </form>
                <% } else if (m.current_status === 'EM_REVISAO' && m.active_review_id && (user.roleCode === 'ADMINISTRADOR' || user.permissions.includes('revisoes.aprovar'))) { %>
                  <a href="/revisoes/<%= m.active_review_id %>/analise" class="btn btn-primary" style="padding: 0.375rem 0.75rem; font-size: 0.875rem;">
                    🔍 Avaliação Comparativa
                  </a>
                  <form action="/revisoes/<%= m.active_review_id %>/concluir" method="POST" style="display: inline;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="status" value="APROVADO">
                    <button type="submit" class="btn" style="background: var(--color-success); color: #fff; padding: 0.375rem 0.75rem; font-size: 0.875rem;">
                      ✔ Aprovar
                    </button>
                  </form>
                  <form action="/revisoes/<%= m.active_review_id %>/concluir" method="POST" style="display: inline;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="status" value="CORRECAO_SOLICITADA">
                    <button type="submit" class="btn" style="background: var(--color-warning); color: #fff; padding: 0.375rem 0.75rem; font-size: 0.875rem;">
                      ⚠️ Correção
                    </button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<!-- HISTÓRICO RECENTE DE AVALIAÇÕES -->
<section aria-labelledby="sec-historico">
  <h2 id="sec-historico" style="font-size: 1.25rem; font-weight: 600; margin-bottom: 1rem;">
    Histórico de Análises Concluídas
  </h2>

  <div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--border-radius); overflow-x: auto;">
    <table style="width: 100%; border-collapse: collapse; text-align: left;" aria-describedby="sec-historico">
      <thead>
        <tr style="border-bottom: 2px solid var(--border-color); background: rgba(0,0,0,0.02);">
          <th scope="col" style="padding: 1rem;">Material</th>
          <th scope="col" style="padding: 1rem;">Versão</th>
          <th scope="col" style="padding: 1rem;">Revisor</th>
          <th scope="col" style="padding: 1rem;">Decisão</th>
          <th scope="col" style="padding: 1rem;">Data/Hora</th>
        </tr>
      </thead>
      <tbody>
        <% if (recentReviews.length === 0) { %>
          <tr>
            <td colspan="5" style="padding: 2rem; text-align: center; color: var(--text-muted);">
              Nenhuma revisão finalizada registrada.
            </td>
          </tr>
        <% } else { %>
          <% recentReviews.forEach(r => { %>
            <tr style="border-bottom: 1px solid var(--border-color);">
              <td style="padding: 1rem; font-weight: 600;"><%= r.material_title %></td>
              <td style="padding: 1rem;">v<%= r.version_number %></td>
              <td style="padding: 1rem;"><%= r.reviewer_name %></td>
              <td style="padding: 1rem;">
                <span class="role-tag" style="background: <%= r.status === 'APROVADO' ? 'var(--color-success)' : 'var(--color-error)' %>;">
                  <%= r.status %>
                </span>
              </td>
              <td style="padding: 1rem; font-size: 0.875rem; color: var(--text-muted);">
                <%= new Date(r.created_at).toLocaleString('pt-BR') %>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</section>
