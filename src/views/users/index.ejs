<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
  <div>
    <h1 style="font-size: 1.75rem; font-weight: 700;">Gestão de Usuários</h1>
    <p style="color: var(--text-muted);">Controle institucional de contas e perfis de acesso</p>
  </div>
  <% if (user.roleCode === 'ADMINISTRADOR' || user.permissions.includes('usuarios.criar')) { %>
    <a href="#modal-novo-usuario" class="btn btn-primary" onclick="document.getElementById('modal-novo-usuario').style.display='block'; document.getElementById('nome-user').focus(); return false;">
      + Novo Usuário
    </a>
  <% } %>
</div>

<!-- TABELA DE USUÁRIOS -->
<div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--border-radius); overflow-x: auto;">
  <table style="width: 100%; border-collapse: collapse; text-align: left;" aria-label="Lista de Usuários">
    <thead>
      <tr style="border-bottom: 2px solid var(--border-color); background: rgba(0,0,0,0.02);">
        <th scope="col" style="padding: 1rem;">Nome</th>
        <th scope="col" style="padding: 1rem;">E-mail</th>
        <th scope="col" style="padding: 1rem;">Matrícula</th>
        <th scope="col" style="padding: 1rem;">Função / Papel</th>
        <th scope="col" style="padding: 1rem;">Status</th>
        <th scope="col" style="padding: 1rem;">Ações</th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach(u => { %>
        <tr style="border-bottom: 1px solid var(--border-color);">
          <td style="padding: 1rem; font-weight: 600;"><%= u.name %></td>
          <td style="padding: 1rem;"><%= u.email %></td>
          <td style="padding: 1rem; color: var(--text-muted);"><%= u.registration_number || '-' %></td>
          <td style="padding: 1rem;">
            <span class="role-tag"><%= u.role_name || 'Sem Papel' %></span>
          </td>
          <td style="padding: 1rem;">
            <span class="role-tag" style="background: <%= u.status === 'ACTIVE' ? 'var(--color-success)' : 'var(--color-error)' %>;">
              <%= u.status === 'ACTIVE' ? 'Ativo' : 'Inativo' %>
            </span>
          </td>
          <td style="padding: 1rem;">
            <% if (user.roleCode === 'ADMINISTRADOR' || user.permissions.includes('usuarios.desativar')) { %>
              <form action="/usuarios/<%= u.id %>/status" method="POST" style="display: inline;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn" style="border: 1px solid var(--border-color); padding: 0.375rem 0.75rem; font-size: 0.875rem; color: <%= u.status === 'ACTIVE' ? 'var(--color-error)' : 'var(--color-success)' %>;">
                  <%= u.status === 'ACTIVE' ? 'Desativar' : 'Reativar' %>
                </button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<!-- MODAL CADASTRAR USUÁRIO -->
<div id="modal-novo-usuario" role="dialog" aria-modal="true" aria-labelledby="modal-u-titulo" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); padding: 2rem; z-index: 1000;">
  <div class="auth-card" style="margin: 3rem auto; max-width: 500px;">
    <h2 id="modal-u-titulo" style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem;">Cadastrar Novo Usuário</h2>
    <form action="/usuarios" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label for="nome-user" class="form-label">Nome Completo <span class="required-indicator">*</span></label>
        <input type="text" id="nome-user" name="name" class="form-input" required placeholder="Ex: Maria Pereira">
      </div>

      <div class="form-group">
        <label for="email-user" class="form-label">E-mail Institucional <span class="required-indicator">*</span></label>
        <input type="email" id="email-user" name="email" class="form-input" required placeholder="maria@acessilia.ufg.br">
      </div>

      <div class="form-group">
        <label for="matricula-user" class="form-label">Matrícula</label>
        <input type="text" id="matricula-user" name="registrationNumber" class="form-input" placeholder="Ex: DOC-2026">
      </div>

      <div class="form-group">
        <label for="role-user" class="form-label">Papel / Perfil de Acesso <span class="required-indicator">*</span></label>
        <select id="role-user" name="roleId" class="form-input" required>
          <% roles.forEach(r => { %>
            <option value="<%= r.id %>"><%= r.name %></option>
          <% }) %>
        </select>
      </div>

      <div style="display: flex; gap: 1rem; margin-top: 1.5rem; justify-content: flex-end;">
        <button type="button" class="btn" style="border: 1px solid var(--border-color);" onclick="document.getElementById('modal-novo-usuario').style.display='none';">
          Cancelar
        </button>
        <button type="submit" class="btn btn-primary">
          Cadastrar Usuário
        </button>
      </div>
    </form>
  </div>
</div>
