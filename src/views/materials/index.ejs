<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
  <div>
    <h1 style="font-size: 1.75rem; font-weight: 700;">Materiais Acadêmicos</h1>
    <p style="color: var(--text-muted);">Acervo acessível e fluxo de processamento</p>
  </div>
  <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
    <a href="/relatorios/materiais.csv" class="btn" style="border: 1px solid var(--border-color); font-size: 0.875rem;" download>
      📥 Exportar CSV
    </a>
    <% if (user.roleCode === 'ADMINISTRADOR' || user.permissions.includes('materiais.enviar')) { %>
      <a href="#modal-novo-material" class="btn btn-primary" onclick="document.getElementById('modal-novo-material').style.display='block'; document.getElementById('titulo-material').focus(); return false;">
        + Enviar Material
      </a>
    <% } %>
  </div>
</div>

<!-- FILTROS E BUSCA ACESSÍVEL -->
<div role="search" aria-label="Filtros e Busca de Materiais" style="margin-bottom: 1.5rem; background: var(--bg-surface); padding: 1rem; border: 1px solid var(--border-color); border-radius: var(--border-radius); display: flex; gap: 1rem; flex-wrap: wrap; align-items: flex-end;">
  <div style="flex: 1; min-width: 240px;">
    <label for="input-busca-materiais" class="form-label" style="font-size: 0.875rem;">Buscar por título ou disciplina</label>
    <input type="search" id="input-busca-materiais" class="form-input" placeholder="Digite para filtrar instantaneamente..." oninput="filtrarMateriais()" aria-controls="tabela-materiais">
  </div>
  <div style="min-width: 180px;">
    <label for="filtro-status-materiais" class="form-label" style="font-size: 0.875rem;">Filtrar por Status</label>
    <select id="filtro-status-materiais" class="form-input" onchange="filtrarMateriais()">
      <option value="">Todos os status</option>
      <option value="ENVIADO">ENVIADO</option>
      <option value="AGUARDANDO_PROCESSAMENTO">AGUARDANDO_PROCESSAMENTO</option>
      <option value="PROCESSANDO">PROCESSANDO</option>
      <option value="AGUARDANDO_REVISAO">AGUARDANDO_REVISAO</option>
      <option value="EM_REVISAO">EM_REVISAO</option>
      <option value="APROVADO">APROVADO</option>
      <option value="PUBLICADO">PUBLICADO</option>
    </select>
  </div>
</div>

<!-- TABELA DE MATERIAIS COM AÇÕES EM LOTE (BULK ACTIONS) -->
<form id="form-bulk-actions" action="/materiais/bulk" method="POST">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <% if (user.roleCode === 'ADMINISTRADOR' || user.permissions.includes('materiais.enviar')) { %>
    <div id="bulk-actions-toolbar" style="display: none; background: #e0f2fe; border: 1px solid #7dd3fc; border-radius: var(--border-radius); padding: 0.75rem 1rem; margin-bottom: 1rem; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
      <span id="bulk-counter" style="font-weight: 600; color: #0369a1;">0 material(is) selecionado(s)</span>
      <div style="display: flex; gap: 0.5rem;">
        <button type="submit" name="action" value="APPROVE" class="btn btn-sm btn-primary">✔ Aprovar Selecionados</button>
        <button type="submit" name="action" value="REPROCESS" class="btn btn-sm" style="border: 1px solid var(--border-color); background: white;">🔄 Reprocessar no Core</button>
      </div>
    </div>
  <% } %>

  <div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--border-radius); overflow-x: auto;">
    <table id="tabela-materiais" style="width: 100%; border-collapse: collapse; text-align: left;" aria-label="Lista de Materiais">
      <thead>
        <tr style="border-bottom: 2px solid var(--border-color); background: rgba(0,0,0,0.02);">
          <% if (user.roleCode === 'ADMINISTRADOR' || user.permissions.includes('materiais.enviar')) { %>
            <th scope="col" style="padding: 1rem; width: 40px;">
              <input type="checkbox" id="check-all-materials" onclick="toggleSelectAll(this)" aria-label="Selecionar todos os materiais da página">
            </th>
          <% } %>
          <th scope="col" style="padding: 1rem;">Título</th>
          <th scope="col" style="padding: 1rem;">Disciplina</th>
          <th scope="col" style="padding: 1rem;">Docente</th>
          <th scope="col" style="padding: 1rem;">Categoria</th>
          <th scope="col" style="padding: 1rem;">Status do Processamento</th>
          <th scope="col" style="padding: 1rem;">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% if (materials.length === 0) { %>
          <tr>
            <td colspan="7" style="padding: 2rem; text-align: center; color: var(--text-muted);">
              Nenhum material disponível no momento para seu perfil.
            </td>
          </tr>
        <% } else { %>
          <% materials.forEach(m => { %>
            <tr id="mat-row-<%= m.id %>" style="border-bottom: 1px solid var(--border-color);">
              <% if (user.roleCode === 'ADMINISTRADOR' || user.permissions.includes('materiais.enviar')) { %>
                <td style="padding: 1rem;">
                  <input type="checkbox" name="materialIds" value="<%= m.id %>" class="material-checkbox" onchange="updateBulkToolbar()" aria-label="Selecionar material <%= m.title %>">
                </td>
              <% } %>
              <td style="padding: 1rem; font-weight: 600;">
                <%= m.title %>
                <% if (m.publish_at) { %>
                  <div style="font-size: 0.75rem; color: var(--text-muted); font-weight: normal;">
                    🗓 Agendado para: <%= new Date(m.publish_at).toLocaleString('pt-BR') %>
                  </div>
                <% } %>
              </td>
              <td style="padding: 1rem;"><%= m.subject_name %></td>
              <td style="padding: 1rem; color: var(--text-secondary);"><%= m.teacher_name %></td>
              <td style="padding: 1rem;"><%= m.category %></td>
              <td style="padding: 1rem;">
                <span id="mat-badge-<%= m.id %>" class="role-tag" style="background: <%= m.current_status === 'APROVADO' ? 'var(--color-success)' : (m.current_status === 'PROCESSANDO' ? 'var(--color-warning)' : 'var(--color-primary)') %>;">
                  <%= m.current_status %>
                </span>
              </td>
              <td style="padding: 1rem;">
                <a href="/materiais/<%= m.id %>" class="btn" style="border: 1px solid var(--border-color); padding: 0.375rem 0.75rem; font-size: 0.875rem;">
                  Visualizar Histórico
                </a>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</form>

<!-- MODAL ENVIAR MATERIAL -->
<div id="modal-novo-material" role="dialog" aria-modal="true" aria-labelledby="modal-mat-titulo" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); padding: 2rem; z-index: 1000;">
  <div class="auth-card" style="margin: 3rem auto; max-width: 500px;">
    <h2 id="modal-mat-titulo" style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem;">Enviar Material para Acessibilidade</h2>
    <form action="/materiais" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label for="titulo-material" class="form-label">Título do Material <span class="required-indicator">*</span></label>
        <input type="text" id="titulo-material" name="title" class="form-input" required placeholder="Ex: Slides Aula 01 - Criptografia">
      </div>

      <div class="form-group">
        <label for="desc-material" class="form-label">Descrição Pedagógica</label>
        <textarea id="desc-material" name="description" class="form-input" rows="3" placeholder="Contexto sobre o material..."></textarea>
      </div>

      <div class="form-group">
        <label for="sel-disc-mat" class="form-label">Disciplina <span class="required-indicator">*</span></label>
        <select id="sel-disc-mat" name="subjectId" class="form-input" required>
          <% subjects.forEach(s => { %>
            <option value="<%= s.id %>"><%= s.name %> (<%= s.code %>)</option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="sel-turma-mat" class="form-label">Turma / Aula Associada (Escopo Discente)</label>
        <select id="sel-turma-mat" name="classId" class="form-input">
          <option value="">Nenhuma turma específica (Geral)</option>
          <% (locals.classes || []).forEach(cl => { %>
            <option value="<%= cl.id %>"><%= cl.code %> — <%= cl.subject_name %> (<%= cl.course_name %>)</option>
          <% }) %>
        </select>
        <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">
          💡 Associar à turma garante que apenas os alunos matriculados nessa aula tenham acesso ao material após a aprovação.
        </p>
      </div>

      <div class="form-group">
        <label for="sel-cat-mat" class="form-label">Categoria <span class="required-indicator">*</span></label>
        <select id="sel-cat-mat" name="category" class="form-input" required>
          <option value="SLIDE">Slide / Apresentação</option>
          <option value="LIVRO">Livro / Capítulo</option>
          <option value="APOSTILA">Apostila / Texto</option>
          <option value="EXERCICIO">Lista de Exercícios</option>
          <option value="AVALIACAO">Avaliação / Prova</option>
        </select>
      </div>

      <div class="form-group">
        <label for="agendamento-mat" class="form-label">Agendamento de Liberação (Opcional)</label>
        <input type="datetime-local" id="agendamento-mat" name="publishAt" class="form-input">
        <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">
          ⏰ Se definido, os discentes só terão acesso a visualizar e baixar o material a partir desta data/hora.
        </p>
      </div>

      <div class="form-group">
        <label for="arquivo-upload" class="form-label">Arquivo para Acessibilização <span class="required-indicator">*</span></label>
        
        <!-- DROPZONE ACESSÍVEL VIA ARRASTAR & SOLTAR OU TECLADO -->
        <div id="dropzone-material" 
             tabindex="0" 
             role="button" 
             aria-label="Área para envio de arquivo. Pressione Enter ou Espaço para escolher do seu computador ou arraste o arquivo aqui"
             style="border: 2px dashed var(--color-primary); border-radius: var(--border-radius); padding: 1.5rem; text-align: center; background: rgba(0,0,0,0.02); cursor: pointer; transition: all 0.2s ease;">
          <div style="font-size: 2rem; margin-bottom: 0.5rem;" aria-hidden="true">📁</div>
          <p style="font-weight: 600; margin-bottom: 0.25rem;" id="dropzone-label">
            Clique aqui, pressione Enter ou arraste seu arquivo (PDF, DOCX, Imagem)
          </p>
          <p style="font-size: 0.75rem; color: var(--text-muted);">Tamanho máximo suportado: 50MB</p>
          
          <input type="file" id="arquivo-upload" name="file" style="display: none;" accept=".pdf,.docx,.doc,.pptx,.ppt,.png,.jpg,.jpeg,.txt" onchange="handleFileSelected(this.files[0])">
          <input type="hidden" id="nome-arquivo" name="filename" value="">
        </div>

        <!-- BARRA DE PROGRESSO ACESSÍVEL -->
        <div id="upload-progress-container" style="display: none; margin-top: 1rem;">
          <div style="display: flex; justify-content: space-between; font-size: 0.875rem; margin-bottom: 0.25rem;">
            <span id="upload-filename-display" style="font-weight: 600;">arquivo.pdf</span>
            <span id="upload-percentage" aria-live="polite">100%</span>
          </div>
          <progress id="upload-progress-bar" value="100" max="100" style="width: 100%; height: 8px; border-radius: 4px;"></progress>
        </div>
      </div>

      <div style="display: flex; gap: 1rem; margin-top: 1.5rem; justify-content: flex-end;">
        <button type="button" class="btn" style="border: 1px solid var(--border-color);" onclick="document.getElementById('modal-novo-material').style.display='none';">
          Cancelar
        </button>
        <button type="submit" id="btn-submit-material" class="btn btn-primary">
          Enviar e Processar no Acessilia
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function filtrarMateriais() {
    const termo = document.getElementById('input-busca-materiais').value.toLowerCase().trim();
    const statusFiltro = document.getElementById('filtro-status-materiais').value;
    const linhas = document.querySelectorAll('#tabela-materiais tbody tr');

    linhas.forEach(linha => {
      const colunas = linha.querySelectorAll('td');
      if (colunas.length < 5) return;

      const titulo = colunas[0].textContent.toLowerCase();
      const disciplina = colunas[1].textContent.toLowerCase();
      const status = colunas[4].textContent.trim();

      const matchTermo = !termo || titulo.includes(termo) || disciplina.includes(termo);
      const matchStatus = !statusFiltro || status === statusFiltro;

      linha.style.display = (matchTermo && matchStatus) ? '' : 'none';
    });
  }

  // MANIPULAÇÃO DO DROPZONE ACESSÍVEL
  const dropzone = document.getElementById('dropzone-material');
  const fileInput = document.getElementById('arquivo-upload');

  if (dropzone && fileInput) {
    dropzone.addEventListener('click', () => fileInput.click());
    dropzone.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        fileInput.click();
      }
    });

    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.style.background = 'rgba(0,0,0,0.06)';
      dropzone.style.borderColor = 'var(--color-primary-hover)';
    });

    dropzone.addEventListener('dragleave', () => {
      dropzone.style.background = 'rgba(0,0,0,0.02)';
      dropzone.style.borderColor = 'var(--color-primary)';
    });

    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.style.background = 'rgba(0,0,0,0.02)';
      dropzone.style.borderColor = 'var(--color-primary)';
      if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
        handleFileSelected(e.dataTransfer.files[0]);
      }
    });
  }

  function handleFileSelected(file) {
    if (!file) return;
    document.getElementById('nome-arquivo').value = file.name;
    document.getElementById('upload-filename-display').textContent = `${file.name} (${(file.size / (1024 * 1024)).toFixed(2)} MB)`;
    document.getElementById('upload-progress-container').style.display = 'block';
    document.getElementById('dropzone-label').textContent = `✔ Arquivo selecionado: ${file.name}`;
    
    // Anúncio de acessibilidade
    const announcer = document.getElementById('aria-status-announcer');
    if (announcer) {
      announcer.textContent = `Arquivo ${file.name} selecionado com sucesso e pronto para envio.`;
    }
  }

  // GERENCIAMENTO DE AÇÕES EM LOTE (BULK ACTIONS)
  function toggleSelectAll(master) {
    const checkboxes = document.querySelectorAll('.material-checkbox');
    checkboxes.forEach(cb => cb.checked = master.checked);
    updateBulkToolbar();
  }

  function updateBulkToolbar() {
    const selected = document.querySelectorAll('.material-checkbox:checked');
    const toolbar = document.getElementById('bulk-actions-toolbar');
    const counter = document.getElementById('bulk-counter');
    if (!toolbar || !counter) return;

    if (selected.length > 0) {
      toolbar.style.display = 'flex';
      counter.textContent = `${selected.length} material(is) selecionado(s)`;
    } else {
      toolbar.style.display = 'none';
      const master = document.getElementById('check-all-materials');
      if (master) master.checked = false;
    }
  }

  // ATUALIZAÇÃO EM TEMPO REAL VIA SSE (SERVER-SENT EVENTS)
  window.addEventListener('materialStatusUpdated', function(e) {
    const { materialId, status } = e.detail;
    const badge = document.getElementById(`mat-badge-${materialId}`);
    if (badge) {
      badge.textContent = status;
      badge.style.background = status === 'APROVADO' ? 'var(--color-success)' : (status === 'PROCESSANDO' ? 'var(--color-warning)' : 'var(--color-primary)');
      const announcer = document.getElementById('aria-status-announcer');
      if (announcer) {
        announcer.textContent = `Status do material atualizado em tempo real para ${status}`;
      }
    }
  });
</script>
