        <strong>Resumo Pedagógico:</strong> <%= material.description || 'Material acadêmico disponibilizado para a disciplina ' + material.subject_name + '.' %>
      </p>

      <div id="material-full-text">
        <% if (locals.accessibleHtmlPreview) { %>
          <div id="accessible-book-content" class="accessible-book-content" style="margin-top: 1.5rem; line-height: 1.9; font-size: 1.05rem; border-top: 1px solid var(--border-color); padding-top: 1.5rem;">
