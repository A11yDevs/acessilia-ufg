          <option value="FORMULA">Fórmula ou Notação Matemática confusa</option>
          <option value="IMAGEM_ALT">Imagem ou Gráfico sem descrição adequada</option>
          <option value="TABELA">Tabela ilegível por leitor de tela</option>
          <option value="AUDIO_SINTESE">Áudio com pronúncia ou cadência errada</option>
          <option value="OUTRO">Outra barreira</option>
        </select>
      </div>

      <div class="form-group">
        <label for="desc-feedback-discente" class="form-label">Detalhes da Dificuldade <span class="required-indicator">*</span></label>
        <textarea id="desc-feedback-discente" name="description" class="form-input" rows="3" required placeholder="Explique em qual parte (slide/página) ocorreu a dificuldade..."></textarea>
      </div>

      <div style="display: flex; gap: 1rem; margin-top: 1.5rem; justify-content: flex-end;">
        <button type="button" class="btn" style="border: 1px solid var(--border-color);" onclick="document.getElementById('modal-feedback-a11y').style.display='none';">
          Cancelar
        </button>
        <button type="submit" class="btn btn-primary">
          Enviar Apontamento
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  // CONTROLE DO PLAYER NATIVO DE ÁUDIO COM ATALHOS DE TECLADO
  const player = document.getElementById('native-audio-player');
  const playBtn = document.getElementById('btn-audio-playpause');
  const speedIndicator = document.getElementById('audio-speed-indicator');

  function setAudioSpeed(speed) {
    if (player) {
      player.playbackRate = speed;
      if (speedIndicator) speedIndicator.textContent = `Velocidade atual: ${speed.toFixed(2)}x`;
      announceA11y(`Velocidade de reprodução alterada para ${speed} vezes`);
      document.querySelectorAll('#audio-speed-control .btn-speed').forEach(btn => {
        btn.style.fontWeight = 'normal';
      });
      if (event && event.target && event.target.classList.contains('btn-speed')) {
        event.target.style.fontWeight = 'bold';
      }
    }
  }

  function adjustAudioSpeed(delta) {
    if (!player) return;
    let newSpeed = Math.min(Math.max(player.playbackRate + delta, 0.5), 2.5);
    setAudioSpeed(newSpeed);
  }

  function toggleAudioPlayback() {
    if (!player) return;
    if (player.paused) {
      player.play();
      if (playBtn) playBtn.textContent = '⏸ Pausar (Espaço)';
      announceA11y('Áudio em reprodução');
    } else {
      player.pause();
      if (playBtn) playBtn.textContent = '▶ Reproduzir (Espaço)';
      announceA11y('Áudio pausado');
    }
  }

  function seekAudio(seconds) {
    if (!player) return;
    player.currentTime = Math.max(0, Math.min(player.duration || 0, player.currentTime + seconds));
    announceA11y(`${seconds > 0 ? 'Avançado' : 'Retrocedido'} ${Math.abs(seconds)} segundos`);
  }

  // Atalhos de Teclado Globais para Acessibilidade
  document.addEventListener('keydown', (e) => {
    // Não interceptar digitação em campos de texto
    const tag = e.target.tagName.toLowerCase();
    if (tag === 'input' || tag === 'textarea' || tag === 'select') return;

    if (e.code === 'Space') {
      e.preventDefault();
      toggleAudioPlayback();
    } else if (e.key === 'j' || e.key === 'J') {
      e.preventDefault();
      seekAudio(-5);
    } else if (e.key === 'l' || e.key === 'L') {
      e.preventDefault();
      seekAudio(5);
    } else if (e.key === '[') {
      e.preventDefault();
      adjustAudioSpeed(-0.25);
    } else if (e.key === ']') {
      e.preventDefault();
      adjustAudioSpeed(0.25);
    }
  });

  // CONTROLES DE TIPOGRAFIA DO LEITOR INTEGRADO
  const contentEl = document.getElementById('material-accessible-content');

  function setReaderFont(font) {
    if (!contentEl) return;
    contentEl.style.fontFamily = font;
    announceA11y(`Fonte alterada para ${font.includes('OpenDyslexic') ? 'dislexia' : 'padrão'}`);
  }

  function setReaderLineHeight(lh) {
    if (!contentEl) return;
    contentEl.style.lineHeight = lh;
    announceA11y(`Espaçamento entre linhas ajustado para ${lh}`);
  }

  function setReaderTheme(theme) {
    if (!contentEl) return;
    if (theme === 'yellow-black') {
      contentEl.style.background = '#000000';
      contentEl.style.color = '#ffff00';
      contentEl.style.borderColor = '#ffff00';
    } else if (theme === 'cyan-blue') {
      contentEl.style.background = '#001f3f';
      contentEl.style.color = '#7fdbff';
      contentEl.style.borderColor = '#7fdbff';
    } else {
      contentEl.style.background = 'var(--bg-primary)';
      contentEl.style.color = 'inherit';
      contentEl.style.borderColor = 'var(--border-color)';
    }
    announceA11y(`Tema visual do leitor atualizado`);
  }

  function announceA11y(msg) {
    const el = document.getElementById('aria-status-announcer');
    if (el) el.textContent = msg;
  }

  // REPRODUTOR INTELIGENTE PIPER-TTS LOCAL COM CHUNKS, CSS SPEECH E LÉXICOS
  const ttsPlayer = {
    audio: new Audio(),
    chunks: [],
    currentIndex: 0,
    isPlaying: false,
    materialId: <%= material.id %>,
    highlightEl: null,
    domElements: []
  };

  const _SLASH = String.fromCharCode(47);
  function buildApiUrl(parts) {
    const isGestor = window.location.pathname.indexOf('gestor') !== -1;
    const prefix = isGestor ? ['gestor'] : [];
    return _SLASH + prefix.concat(parts).join(_SLASH);
  }

  async function loadTtsChunks() {
    if (ttsPlayer.chunks.length > 0) return ttsPlayer.chunks;
    try {
      const chunksUrl = buildApiUrl(['api', 'v1', 'materials', String(ttsPlayer.materialId), 'tts', 'chunks']);
      const res = await fetch(chunksUrl, { credentials: 'same-origin' });
      if (res.ok) {
        const data = await res.json();
        ttsPlayer.chunks = data.chunks || [];
        updateChunkIndicator();
        indexDomElementsForHighlight();
      }
    } catch (e) {
      console.warn('[TTS] Falha ao carregar chunks do material:', e);
    }
    return ttsPlayer.chunks;
  }

  function indexDomElementsForHighlight() {
    const container = document.getElementById('accessible-book-content') || document.getElementById('material-accessible-content');
    if (!container) return;
    // Seleciona blocos de parágrafos, cabeçalhos, citações e itens
    const blocks = Array.from(container.querySelectorAll('h1, h2, h3, h4, h5, h6, p, blockquote, .a11y-audiodesc-card'));
    ttsPlayer.domElements = blocks;
  }

  function updateChunkIndicator() {
    const el = document.getElementById('tts-chunk-indicator');
    if (el) {
      const total = ttsPlayer.chunks.length || 1;
      const current = Math.min(ttsPlayer.currentIndex + 1, total);
      el.textContent = `Bloco ${current}/${total}`;
    }
  }

  async function toggleTtsPlayback() {
    const btn = document.getElementById('btn-play-voice');
    if (ttsPlayer.isPlaying) {
      ttsPlayer.audio.pause();
      ttsPlayer.isPlaying = false;
      if (btn) btn.textContent = '🔊 Retomar Leitura';
      announceA11y('Leitura pausada');
      return;
    }

    if (ttsPlayer.chunks.length === 0) {
      if (btn) btn.textContent = '⏳ Carregando Voz Neural...';
      await loadTtsChunks();
    }

    if (ttsPlayer.chunks.length === 0) {
      // Fallback para síntese nativa do navegador se não houver chunks
      fallbackBrowserSpeech();
      return;
    }

    playCurrentTtsChunk();
  }

  async function playCurrentTtsChunk() {
    const btn = document.getElementById('btn-play-voice');
    const voice = document.getElementById('tts-voice-select')?.value || 'pt_BR-cadu-medium';
    const rate = document.getElementById('tts-rate-select')?.value || '1.0';

    if (ttsPlayer.currentIndex >= ttsPlayer.chunks.length) {
      stopTtsPlayback();
      announceA11y('Fim da leitura do documento');
      return;
    }

    const chunk = ttsPlayer.chunks[ttsPlayer.currentIndex];
    highlightTtsElement(ttsPlayer.currentIndex);
    updateChunkIndicator();

    if (btn) btn.textContent = '⏸ Pausar Leitura';
    ttsPlayer.isPlaying = true;

    try {
      const audioUrl = buildApiUrl(['api', 'v1', 'materials', String(ttsPlayer.materialId), 'tts', 'audio']) + '?chunkIndex=' + ttsPlayer.currentIndex + '&voice=' + encodeURIComponent(voice) + '&rate=' + rate + '&t=' + Date.now();
      const res = await fetch(audioUrl, { credentials: 'same-origin' });
      if (!res.ok) throw new Error('Status HTTP ' + res.status);
      const data = await res.json();

      if (!ttsPlayer.isPlaying) return;

      ttsPlayer.audio.pause();
      ttsPlayer.audio.currentTime = 0;
      ttsPlayer.audio.src = data.audio;

      ttsPlayer.audio.onended = () => {
        ttsPlayer.currentIndex++;
        if (ttsPlayer.currentIndex < ttsPlayer.chunks.length) {
          playCurrentTtsChunk();
        } else {
          stopTtsPlayback();
          announceA11y('Fim da leitura do documento');
        }
      };

      ttsPlayer.audio.onerror = (e) => {
        console.warn('[TTS] Erro ao reproduzir chunk via Piper-TTS:', e);
        fallbackChunkSpeech(chunk);
      };

      await ttsPlayer.audio.play();
      announceA11y(`Lendo bloco ${ttsPlayer.currentIndex + 1} de ${ttsPlayer.chunks.length}`);
    } catch (err) {
      console.warn('[TTS] Erro ao carregar chunk de áudio do servidor, usando fallback nativo:', err);
      fallbackChunkSpeech(chunk);
    }
  }

  function fallbackChunkSpeech(chunk) {
    if ('speechSynthesis' in window && chunk) {
      const u = new SpeechSynthesisUtterance(chunk.text);
      u.lang = 'pt-BR';
      u.onend = () => {
        ttsPlayer.currentIndex++;
        if (ttsPlayer.currentIndex < ttsPlayer.chunks.length) {
          playCurrentTtsChunk();
        } else {
          stopTtsPlayback();
        }
      };
      window.speechSynthesis.speak(u);
    }
  }

  function highlightTtsElement(index) {
    if (ttsPlayer.highlightEl) {
      ttsPlayer.highlightEl.classList.remove('a11y-reading-highlight');
    }

    if (ttsPlayer.domElements.length === 0) {
      indexDomElementsForHighlight();
    }

    const target = ttsPlayer.domElements[index];
    if (target) {
      target.classList.add('a11y-reading-highlight');
      ttsPlayer.highlightEl = target;
      target.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }

  function prevTtsChunk() {
    if (ttsPlayer.currentIndex > 0) {
      ttsPlayer.currentIndex--;
      if (ttsPlayer.isPlaying) {
        playCurrentTtsChunk();
      } else {
        highlightTtsElement(ttsPlayer.currentIndex);
        updateChunkIndicator();
      }
    }
  }

  function nextTtsChunk() {
    if (ttsPlayer.chunks.length === 0) return;
    if (ttsPlayer.currentIndex < ttsPlayer.chunks.length - 1) {
      ttsPlayer.currentIndex++;
      if (ttsPlayer.isPlaying) {
        playCurrentTtsChunk();
      } else {
        highlightTtsElement(ttsPlayer.currentIndex);
        updateChunkIndicator();
      }
    }
  }

  function stopTtsPlayback() {
    ttsPlayer.audio.pause();
    ttsPlayer.audio.currentTime = 0;
    ttsPlayer.isPlaying = false;
    ttsPlayer.currentIndex = 0;

    if (ttsPlayer.highlightEl) {
      ttsPlayer.highlightEl.classList.remove('a11y-reading-highlight');
      ttsPlayer.highlightEl = null;
    }

    updateChunkIndicator();
    const btn = document.getElementById('btn-play-voice');
    if (btn) btn.textContent = '🔊 Ler em Voz Alta (Piper-TTS)';
    if ('speechSynthesis' in window) window.speechSynthesis.cancel();
  }

  // Atalhos de retrocompatibilidade
  function toggleSpeech() { toggleTtsPlayback(); }
  function stopSpeech() { stopTtsPlayback(); }

  function fallbackBrowserSpeech() {
    if (!('speechSynthesis' in window)) {
      alert('Síntese de voz não suportada.');
      return;
    }
    const text = document.getElementById('material-accessible-content').innerText;
    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = 'pt-BR';
    utterance.onend = () => {
      document.getElementById('btn-play-voice').textContent = '🔊 Ler em Voz Alta (Piper-TTS)';
    };
    window.speechSynthesis.speak(utterance);
    document.getElementById('btn-play-voice').textContent = '⏸ Lendo...';
  }

  // AUXILIARES DE AUDIODESCRIÇÃO (Piper-TTS Neural com Fallback)
  window.speakAudiodesc = async function(btn) {
    const text = btn.getAttribute('data-text');
    if (!text) return;

    const originalText = btn.textContent;
    btn.textContent = '⏳ Gerando Áudio Neural...';
    btn.disabled = true;

    try {
      const voice = document.getElementById('tts-voice-select')?.value || 'pt_BR-cadu-medium';
      const rate = parseFloat(document.getElementById('tts-rate-select')?.value || '1.0');

      const ttsUrl = buildApiUrl(['api', 'v1', 'tts', 'synthesize']);
      const res = await fetch(ttsUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ text, voice, rate })
      });

      if (res.ok) {
        const data = await res.json();
        const audio = new Audio(data.audio);
        btn.textContent = '🔊 Reproduzindo Audiodescrição...';
        audio.onended = () => {
          btn.textContent = originalText;
          btn.disabled = false;
        };
        audio.onerror = () => {
          fallbackSpeech(text, btn, originalText);
        };
        await audio.play();
        announceA11y('Reproduzindo audiodescrição em alta fidelidade com Piper-TTS');
        return;
      }
    } catch (err) {
      console.warn('[TTS] Falha ao sintetizar audiodescrição no servidor:', err);
    }

    // Fallback nativo
    if ('speechSynthesis' in window) {
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = 'pt-BR';
      btn.textContent = '🔊 Reproduzindo...';
      utterance.onend = () => {
        btn.textContent = originalText;
        btn.disabled = false;
      };
      window.speechSynthesis.speak(utterance);
      announceA11y('Reproduzindo audiodescrição da imagem');
    } else {
      btn.textContent = originalText;
      btn.disabled = false;
    }
  };

  window.speakMath = function(btn) {
    const text = btn.getAttribute('data-text');
    if (!text || !('speechSynthesis' in window)) return;
    window.speechSynthesis.cancel();
    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = 'pt-BR';
    utterance.rate = 0.90;
    btn.textContent = '🔊 Verbalizando Fórmula...';
    utterance.onend = () => {
      btn.textContent = '🔊 Ouvir Equação Falada';
    };
    window.speechSynthesis.speak(utterance);
    announceA11y('Verbalizando notação matemática');
  };

  window.copyAudiodesc = function(btn, text) {
    navigator.clipboard.writeText(text).then(() => {
      const originalText = btn.textContent;
      btn.textContent = '✔ Copiado!';
      announceA11y('Texto copiado para a área de transferência');
      setTimeout(() => {
        btn.textContent = originalText;
      }, 2000);
    });
  };

  // ESCUTA DE EVENTOS SSE PARA PROGRESSO EM TEMPO REAL DO CORE
  (function initLiveProgressSSE() {
    const isProcessing = '<%= material.current_status %>' === 'PROCESSANDO' || '<%= material.current_status %>' === 'AGUARDANDO_PROCESSAMENTO';
    if (!isProcessing) return;

    try {
      const sseUrl = buildApiUrl(['api', 'v1', 'notifications', 'stream']);
      const eventSource = new EventSource(sseUrl);
      eventSource.onmessage = function(event) {
        try {
          const data = JSON.parse(event.data);
          if (data.materialId && Number(data.materialId) === Number('<%= material.id %>')) {
            const percentLabel = document.getElementById('core-progress-percent');
            const fillBar = document.getElementById('core-progress-bar-fill');
            const stepLabel = document.getElementById('core-current-step');

            if (data.type === 'PROCESSING_PROGRESS') {
              if (percentLabel && data.progress !== null) percentLabel.textContent = data.progress + '%';
              if (fillBar && data.progress !== null) fillBar.style.width = data.progress + '%';
              if (stepLabel && data.currentStep) stepLabel.innerHTML = 'Etapa: <strong>' + data.currentStep + '</strong>';
              announceA11y('Progresso da acessibilização: ' + data.currentStep);
            }

            if (data.type === 'MATERIAL_UPDATED' && (data.status === 'AGUARDANDO_REVISAO' || data.status === 'APROVADO')) {
              if (percentLabel) percentLabel.textContent = '100% Concluído!';
              if (fillBar) fillBar.style.width = '100%';
              if (stepLabel) stepLabel.innerHTML = 'Etapa: <strong>Processamento Finalizado! Recarregando...</strong>';
              setTimeout(function() {
                window.location.reload();
              }, 1200);
            }
          }
        } catch (_) {}
      };
    } catch (_) {}
  })();
  // SANITIZAÇÃO E NAVEGAÇÃO SUAVE DO E-READER (TOC e Âncoras)
  (function enhanceEreaderContent() {
    const book = document.getElementById('accessible-book-content');
    if (!book) return;

    // 1. Oculta ou remove metadados técnicos brutos do leitor
    const metaAside = book.querySelector('aside.meta');
    if (metaAside) metaAside.remove();

    // 2. Limpa o Sumário: remove itens espúrios (parágrafos longos ou números soltos capturados pelo OCR)
    const tocItems = book.querySelectorAll('nav.toc li');
    tocItems.forEach(li => {
      const a = li.querySelector('a');
      if (a) {
        const text = a.textContent.trim();
        if (text.length > 120 || /^\d+$/.test(text)) {
          li.remove();
        }
      }
    });

    // 3. Converte falsos títulos h1-h6 com texto longo (> 120 caracteres) em parágrafos normais
    const headings = book.querySelectorAll('h1, h2, h3, h4, h5, h6');
    headings.forEach(h => {
      if (h.closest('nav.toc')) return;
      if (h.textContent.trim().length > 120) {
        const p = document.createElement('p');
        p.id = h.id;
        p.className = h.className;
        p.innerHTML = h.innerHTML;
        h.parentNode.replaceChild(p, h);
      }
    });

    // 4. Intercepta cliques nos links diretos do Sumário para rolagem suave com destaque
    book.addEventListener('click', (e) => {
      const link = e.target.closest('nav.toc a[href^="#"]');
      if (link) {
        const hash = link.getAttribute('href');
        const target = book.querySelector(hash);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          target.classList.add('a11y-reading-highlight');
          setTimeout(() => target.classList.remove('a11y-reading-highlight'), 1600);
        }
      }
    });

    // 5. Garante que todos os links do certificado digital utilizem o prefixo /gestor
    if (window.location.pathname.includes('/gestor')) {
      document.querySelectorAll('a[href*="/certificados/material/"]').forEach(a => {
        const rawHref = a.getAttribute('href') || '';
        if (rawHref.startsWith('/certificados/')) {
          a.setAttribute('href', '/gestor' + rawHref);
        } else if (!a.href.includes('/gestor/')) {
          a.href = a.href.replace(/(\/\/[^\/]+)(\/certificados\/)/, '$1/gestor$2');
        }
      });
    }
  })();
</script>
