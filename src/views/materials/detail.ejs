                  <span class="a11y-audiodesc-tag">
                    <span aria-hidden="true">🖼️</span> Imagem <%= idx + 1 %>: Audiodescrição
                  </span>
                  <span class="a11y-audiodesc-badge"><%= at.status === 'APROVADO' ? 'Aprovado por Revisor' : 'Sugerido por IA' %></span>
