<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h1 style="font-size: 1.75rem; font-weight: 700;">Catálogo de Disciplinas</h1>
    <p style="color: var(--text-muted);">Gestão acadêmica de disciplinas institucionais e matrizes</p>
  </div>
  <% if (user.roleCode === 'ADMINISTRADOR' || user.permissions.includes('cursos.gerenciar')) { %>
    <button type="button" class="btn btn-primary" onclick="document.getElementById('modal-nova-disciplina').style.display='block'; document.getElementById('nome-disciplina').focus();">
      + Nova Disciplina
    </button>
  <% } %>
</div>

<!-- BARRA DE BUSCA RÁPIDA -->
<div class="stat-card" style="margin-bottom: 1.5rem; padding: 1rem 1.25rem;">
  <div style="max-width: 450px;">
    <label for="input-busca-disciplina" class="form-label" style="font-size: 0.8125rem;">Buscar disciplina:</label>
    <input type="search" id="input-busca-disciplina" class="form-input" placeholder="Digite código ou nome da disciplina..." oninput="filtrarDisciplinas(this.value)">
  </div>
</div>

<!-- TABELA DE DISCIPLINAS -->
<div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--border-radius); overflow-x: auto;">
  <table style="width: 100%; border-collapse: collapse; text-align: left;" aria-label="Lista de Disciplinas da Instituição">
    <thead>
      <tr style="border-bottom: 2px solid var(--border-color); background: rgba(0,0,0,0.02);">
        <th scope="col" style="padding: 1rem;">Código</th>
        <th scope="col" style="padding: 1rem;">Nome da Disciplina</th>
        <th scope="col" style="padding: 1rem;">Departamento</th>
        <th scope="col" style="padding: 1rem;">Carga Horária</th>
        <th scope="col" style="padding: 1rem;">Status</th>
        <th scope="col" style="padding: 1rem;">Ações</th>
      </tr>
    </thead>
    <tbody id="tbody-disciplinas">
      <% if (subjects.length === 0) { %>
        <tr>
          <td colspan="6" style="padding: 2rem; text-align: center; color: var(--text-muted);">
            Nenhuma disciplina cadastrada no momento.
          </td>
        </tr>
      <% } else { %>
        <% subjects.forEach(s => { %>
          <tr class="disc-row" style="border-bottom: 1px solid var(--border-color);">
            <td style="padding: 1rem; font-weight: 600;"><code><%= s.code %></code></td>
            <td style="padding: 1rem; font-weight: 500;"><%= s.name %></td>
            <td style="padding: 1rem; color: var(--text-secondary);"><%= s.department_name %></td>
            <td style="padding: 1rem;"><%= s.workload_hours %> horas</td>
            <td style="padding: 1rem;">
              <span class="role-tag" style="background: #10b981; color: white;">
                <%= s.status %>
              </span>
            </td>
            <td style="padding: 1rem;">
              <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                <a href="/academico/turmas?subjectId=<%= s.id %>" class="btn btn-sm" style="border: 1px solid var(--border-color); font-size: 0.75rem;" title="Ver turmas desta disciplina">
                  🏛️ Turmas
                </a>
              </div>
            </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</div>

<!-- MODAL ACESSÍVEL DE CADASTRO DE DISCIPLINA -->
<div id="modal-nova-disciplina" role="dialog" aria-modal="true" aria-labelledby="modal-disc-titulo" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); padding: 2rem; z-index: 1000;">
  <div class="auth-card" style="margin: 3rem auto; max-width: 500px;">
    <h2 id="modal-disc-titulo" style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem;">Cadastrar Nova Disciplina</h2>
    <form action="/academico/disciplinas" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label for="sel-departamento" class="form-label">Departamento Acadêmico <span class="required-indicator">*</span></label>
        <select id="sel-departamento" name="departmentId" class="form-input" required>
          <% departments.forEach(d => { %>
            <option value="<%= d.id %>"><%= d.name %> (<%= d.code %>)</option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="codigo-disciplina" class="form-label">Código da Disciplina <span class="required-indicator">*</span></label>
        <input type="text" id="codigo-disciplina" name="code" class="form-input" required placeholder="Ex: INF-A11Y" style="text-transform: uppercase;">
      </div>

      <div class="form-group">
        <label for="nome-disciplina" class="form-label">Nome da Disciplina <span class="required-indicator">*</span></label>
        <input type="text" id="nome-disciplina" name="name" class="form-input" required placeholder="Ex: Acessibilidade e Inclusão Digital">
      </div>

      <div class="form-group">
        <label for="ch-disciplina" class="form-label">Carga Horária (Horas) <span class="required-indicator">*</span></label>
        <input type="number" id="ch-disciplina" name="workloadHours" class="form-input" required value="64" min="16" max="256">
      </div>

      <div class="form-group">
        <label for="desc-disciplina" class="form-label">Ementa / Descrição (Opcional)</label>
        <textarea id="desc-disciplina" name="description" class="form-input" rows="3" placeholder="Descrição dos tópicos e ementa..."></textarea>
      </div>

      <div style="display: flex; gap: 1rem; margin-top: 1.5rem; justify-content: flex-end;">
        <button type="button" class="btn" style="border: 1px solid var(--border-color);" onclick="document.getElementById('modal-nova-disciplina').style.display='none';">
          Cancelar
        </button>
        <button type="submit" class="btn btn-primary">
          Salvar Disciplina
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function filtrarDisciplinas(query) {
    const q = (query || '').toLowerCase().trim();
    const rows = document.querySelectorAll('.disc-row');
    rows.forEach(r => {
      const text = r.innerText.toLowerCase();
      r.style.display = !q || text.includes(q) ? '' : 'none';
    });
  }
</script>
