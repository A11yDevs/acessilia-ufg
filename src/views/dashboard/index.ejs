<div style="margin-bottom: 2rem;">
  <h1 style="font-size: 1.75rem; font-weight: 700; color: var(--text-primary);">
    Olá, <%= user.socialName || user.name %>!
  </h1>
  <p style="color: var(--text-muted); margin-top: 0.25rem;">
    Perfil atual: <strong><%= user.roleName %></strong>
  </p>
</div>

<!-- CARDS CONTEXTUAIS BASEADOS NO PAPEL RBAC -->
<section aria-labelledby="sec-resumo" style="margin-bottom: 2.5rem;">
  <h2 id="sec-resumo" style="font-size: 1.25rem; font-weight: 600; margin-bottom: 1rem;">Visão Geral</h2>

  <div class="dashboard-grid">
    <% if (user.roleCode === 'ADMINISTRADOR' || user.roleCode === 'GESTOR_ACESSIBILIDADE') { %>
      <div class="stat-card">
        <div class="stat-card-title">Cobertura de Acessibilidade</div>
        <div class="stat-card-value" style="color: var(--color-success);"><%= stats.accessibilityCoveragePct || 0 %>%</div>
        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;"><%= stats.subjectsWithMaterials || 0 %> de <%= stats.totalSubjects || 0 %> disciplinas atendidas</div>
      </div>
      <div class="stat-card">
        <div class="stat-card-title">Materiais na Plataforma</div>
        <div class="stat-card-value"><%= stats.totalMaterials || 0 %></div>
        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;"><%= stats.approvedMaterials || 0 %> aprovados</div>
      </div>
      <div class="stat-card">
        <div class="stat-card-title">Cursos Institucionais</div>
        <div class="stat-card-value"><%= stats.totalCourses || 0 %></div>
        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;"><%= stats.totalSubjects || 0 %> disciplinas cadastradas</div>
      </div>
      <div class="stat-card">
        <div class="stat-card-title">Revisões Pendentes</div>
        <div class="stat-card-value" style="color: var(--color-warning);"><%= stats.pendingMaterials || 0 %></div>
        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">Aguardando validação humana</div>
      </div>
    <% } else if (user.roleCode === 'PROFESSOR') { %>
      <div class="stat-card">
        <div class="stat-card-title">Meus Materiais Enviados</div>
        <div class="stat-card-value"><%= stats.myMaterials || 0 %></div>
      </div>
      <div class="stat-card">
        <div class="stat-card-title">Aguardando Processamento</div>
        <div class="stat-card-value"><%= stats.pendingJobs || 0 %></div>
      </div>
      <div class="stat-card">
        <div class="stat-card-title">Materiais Aprovados</div>
        <div class="stat-card-value"><%= stats.myApprovedMaterials || 0 %></div>
      </div>
    <% } else if (user.roleCode === 'REVISOR') { %>
      <div class="stat-card">
        <div class="stat-card-title">Revisões Pendentes</div>
        <div class="stat-card-value"><%= stats.pendingReviews || 0 %></div>
      </div>
      <div class="stat-card">
        <div class="stat-card-title">Em Análise Técnica</div>
        <div class="stat-card-value"><%= stats.inProgressReviews || 0 %></div>
      </div>
    <% } else { %>
      <div class="stat-card">
        <div class="stat-card-title">Materiais Acessíveis da Turma</div>
        <div class="stat-card-value"><%= stats.availableMaterials || 0 %></div>
      </div>
      <div class="stat-card">
        <div class="stat-card-title">Minhas Solicitações</div>
        <div class="stat-card-value"><%= stats.myRequests || 0 %></div>
      </div>
    <% } %>
  </div>
</section>

<!-- GRÁFICO SEMÂNTICO ACESSÍVEL DE DISTRIBUIÇÃO DE ACERVO -->
<% if ((user.roleCode === 'ADMINISTRADOR' || user.roleCode === 'GESTOR_ACESSIBILIDADE') && stats.categoriesDistribution && stats.categoriesDistribution.length > 0) { %>
<section aria-labelledby="sec-distribuicao" style="margin-bottom: 2.5rem;">
  <div class="stat-card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 1rem;">
      <div>
        <h2 id="sec-distribuicao" style="font-size: 1.25rem; font-weight: 700;">Distribuição do Acervo Acessível por Categoria</h2>
        <p style="color: var(--text-muted); font-size: 0.875rem;">Representação visual e tabular em conformidade com WCAG 2.2</p>
      </div>
      <a href="/relatorios/conformidade-lbi.html" class="btn btn-primary" style="font-size: 0.875rem;">
        📄 Emitir Relatório LBI (Lei 13.146)
      </a>
    </div>

    <!-- GRÁFICO SVG SEMÂNTICO (BARRAS HORIZONTAIS COM ALTO CONTRASTE) -->
    <div role="img" aria-label="Gráfico de barras indicando quantidade de materiais por categoria acadêmica" style="margin-bottom: 1.5rem;">
      <svg width="100%" height="160" viewBox="0 0 600 160" style="overflow: visible; font-family: inherit;">
        <% 
          const maxCount = Math.max(...stats.categoriesDistribution.map(c => c.total), 1);
          stats.categoriesDistribution.forEach((cat, index) => { 
            const barWidth = Math.round((cat.total / maxCount) * 400);
            const y = index * 32 + 20;
        %>
          <!-- Rótulo da Categoria -->
          <text x="0" y="<%= y + 14 %>" font-size="12" font-weight="600" fill="currentColor"><%= cat.category %></text>
          
          <!-- Barra de Fundo -->
          <rect x="130" y="<%= y %>" width="400" height="18" rx="4" fill="rgba(0,0,0,0.05)" />
          
          <!-- Barra de Valor com Contraste -->
          <rect x="130" y="<%= y %>" width="<%= Math.max(barWidth, 8) %>" height="18" rx="4" fill="var(--color-primary)" />
          
          <!-- Quantidade Numérica -->
          <text x="<%= 140 + barWidth %>" y="<%= y + 14 %>" font-size="12" font-weight="bold" fill="currentColor">
            <%= cat.total %>
          </text>
        <% }) %>
      </svg>
    </div>

    <!-- TABELA ALTERNATIVA DE DADOS PARA LEITORES DE TELA (WCAG 1.1.1) -->
    <details style="font-size: 0.875rem; color: var(--text-secondary); background: var(--bg-surface); padding: 0.75rem; border-radius: var(--border-radius); border: 1px solid var(--border-color);">
      <summary style="cursor: pointer; font-weight: 600;">Ver dados do gráfico em formato de tabela acessível</summary>
      <table style="width: 100%; border-collapse: collapse; margin-top: 0.5rem; text-align: left;">
        <thead>
          <tr style="border-bottom: 1px solid var(--border-color);">
            <th style="padding: 0.5rem;">Categoria</th>
            <th style="padding: 0.5rem;">Total de Materiais</th>
          </tr>
        </thead>
        <tbody>
          <% stats.categoriesDistribution.forEach(cat => { %>
            <tr style="border-bottom: 1px solid var(--border-color);">
              <td style="padding: 0.5rem;"><%= cat.category %></td>
              <td style="padding: 0.5rem; font-weight: bold;"><%= cat.total %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </details>
  </div>
</section>
<% } %>

<!-- REGISTROS RECENTES / AUDITORIA DE SEGURANÇA -->
<% if (user.roleCode === 'ADMINISTRADOR' && recentLogs && recentLogs.length > 0) { %>
<section aria-labelledby="sec-auditoria">
  <h2 id="sec-auditoria" style="font-size: 1.25rem; font-weight: 600; margin-bottom: 1rem;">
    Atividades e Auditoria Recente
  </h2>

  <div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--border-radius); overflow-x: auto;">
    <table style="width: 100%; border-collapse: collapse; text-align: left;" aria-describedby="sec-auditoria">
      <thead>
        <tr style="border-bottom: 2px solid var(--border-color); background: rgba(0,0,0,0.02);">
          <th scope="col" style="padding: 0.875rem 1rem;">Data/Hora</th>
          <th scope="col" style="padding: 0.875rem 1rem;">Usuário</th>
          <th scope="col" style="padding: 0.875rem 1rem;">Ação</th>
          <th scope="col" style="padding: 0.875rem 1rem;">Recurso</th>
          <th scope="col" style="padding: 0.875rem 1rem;">IP</th>
        </tr>
      </thead>
      <tbody>
        <% recentLogs.forEach(log => { %>
          <tr style="border-bottom: 1px solid var(--border-color);">
            <td style="padding: 0.875rem 1rem; font-size: 0.875rem; color: var(--text-muted);">
              <%= new Date(log.created_at).toLocaleString('pt-BR') %>
            </td>
            <td style="padding: 0.875rem 1rem; font-weight: 500;">
              <%= log.user_name || 'Sistema' %>
            </td>
            <td style="padding: 0.875rem 1rem;">
              <code><%= log.action %></code>
            </td>
            <td style="padding: 0.875rem 1rem; color: var(--text-secondary);">
              <%= log.resource %>
            </td>
            <td style="padding: 0.875rem 1rem; font-size: 0.875rem; color: var(--text-muted);">
              <%= log.ip_address || '-' %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<% } %>
